<Window x:Class="WindowChromeApiProposalDemo.TabbedExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WindowChromeApiProposalDemo"
        Title="{Binding SelectedItem.Content.FolderName, ElementName=Tabs}" Width="1180" Height="700" WindowStartupLocation="CenterScreen"
        ThemeMode="System" Background="Transparent">
    <!-- Tabbed = Mica Alt, the backdrop Windows 11 uses for windows with tabs in the title bar.
         The backdrop covers only the tab strip (CaptionHeight, 40) and the navigation bar of the explorer (44):
         GlassFrameThickness.Top = 40 + 44. The rest of the window is an ordinary opaque page. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome FrameMode="ExtendedClientArea" CaptionColor="Transparent" BackdropType="Tabbed"
                            CaptionHeight="40" GlassFrameThickness="0,84,0,0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="NewTab_Executed"/>
        <CommandBinding Command="Close" Executed="CloseTab_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Every explorer sits on the backdrop with the same layer as the selected tab; the page below it is opaque. -->
        <Style TargetType="local:FileExplorerControl">
            <Setter Property="NavigationBarBackground" Value="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"/>
            <Setter Property="PageBackground" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
        </Style>

        <Style x:Key="TabGlyphButton" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab: Windows 11 look. It fills the height of the strip. The title is the name of the folder its explorer shows.
             The selected tab has the same layer as the page below it. -->
        <Style TargetType="TabItem">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Header" Value="{Binding Content.FolderName, RelativeSource={RelativeSource Self}}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tab_PreviewMouseLeftButtonDown"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource TabGlyphButton}" Content="&#xE711;" ToolTip="Close tab" Margin="4,0,0,0"
                                    Command="Close" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#FFF2C14E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Margin="0,0,2,0" Padding="10,0,6,0" CornerRadius="8,8,0,0" Background="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The tab strip lives in the title bar band, the selected page fills the rest. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- tab strip: the title band -->
                                <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Height, RelativeSource={RelativeSource Self}}"/>
                                <!-- page -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,0,0,0" HorizontalAlignment="Left"
                                  Width="{Binding Path=(shell:WindowChrome.TitleBarBounds).Width, RelativeSource={RelativeSource Self}}">
                                <Grid.RowDefinitions>
                                    <!-- A free band above the tabs, as thick as the resize border, so the window can be resized from its top edge.
                                         A maximized window has nothing to resize: the tabs reach the top of the screen. -->
                                    <RowDefinition x:Name="ResizeBand"
                                                   Height="{Binding Path=(shell:WindowChrome.WindowChrome).ResizeBorderThickness.Top, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                    <Button Style="{StaticResource TabGlyphButton}" Content="&#xE710;" ToolTip="New tab" Command="New"
                                            VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter TargetName="ResizeBand" Property="Height" Value="0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Clip="{Binding Path=(shell:WindowChrome.CaptionButtonsClip), RelativeSource={RelativeSource Self}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Y, RelativeSource={RelativeSource Self}}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem><local:FileExplorerControl FolderPath="%USERPROFILE%"/></TabItem>
            <TabItem><local:FileExplorerControl FolderPath="%USERPROFILE%\Documents"/></TabItem>
            <TabItem><local:FileExplorerControl FolderPath="%USERPROFILE%\Pictures"/></TabItem>
        </TabControl>
    </Grid>
</Window>
