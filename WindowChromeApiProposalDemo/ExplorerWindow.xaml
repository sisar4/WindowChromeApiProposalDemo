<Window x:Class="WindowChromeApiProposalDemo.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WindowChromeApiProposalDemo"
        Title="{Binding FolderName, ElementName=Explorer}" Width="1100" Height="680" WindowStartupLocation="CenterScreen"
        ThemeMode="Light" Background="Transparent">
    <!-- The folder view is a native window -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome FrameMode="ExtendedClientArea" CaptionColor="Transparent" BackdropType="Mica" />
    </shell:WindowChrome.WindowChrome>

    <!-- The root is clipped so it never paints over the system caption buttons, and the rows follow what the chrome computes:
         row 0 is the invisible border of a maximized window, row 1 the title band, row 2 the content. -->
    <Grid Clip="{Binding Path=(shell:WindowChrome.CaptionButtonsClip), RelativeSource={RelativeSource Self}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Y, RelativeSource={RelativeSource Self}}"/>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Height, RelativeSource={RelativeSource Self}}"
                           MinHeight="{x:Static SystemParameters.WindowCaptionHeight}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#FFF2C14E" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{Binding Path=(shell:WindowChrome.CaptionForeground), RelativeSource={RelativeSource Self}}"/>
        </StackPanel>

        <local:FileExplorerControl x:Name="Explorer" Grid.Row="2" PageBackground="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
    </Grid>
</Window>