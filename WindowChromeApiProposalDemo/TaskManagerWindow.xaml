<Window x:Class="WindowChromeApiProposalDemo.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WindowChromeApiProposalDemo"
        Title="Task Manager (fake)" Width="1120" Height="720" WindowStartupLocation="CenterScreen"
        ThemeMode="System" Background="Transparent">
    <!-- Acrylic only where the glass extends: 240 px on the left (navigation) and 48 px on top (title bar).
         The rest of the client area is an ordinary opaque card painted by WPF. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome FrameMode="ExtendedClientArea" CaptionColor="Transparent" BackdropType="Acrylic"
                            CaptionHeight="48" GlassFrameThickness="240,48,0,0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:HeatBrushConverter x:Key="Heat"/>

        <Style x:Key="HeatCell" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="NameCell" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <!-- The layout follows the attached properties the chrome computes, so nothing needs hand-made offsets:
         - row 0 is the invisible border of a maximized window (TitleBarBounds.Y),
         - row 1 is the title band (TitleBarBounds.Height, 48 because CaptionHeight is set),
         - the root is clipped (CaptionButtonsClip) so it never paints over the system caption buttons. -->
    <Grid Clip="{Binding Path=(shell:WindowChrome.CaptionButtonsClip), RelativeSource={RelativeSource Self}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Y, RelativeSource={RelativeSource Self}}"/>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Height, RelativeSource={RelativeSource Self}}"
                           MinHeight="{x:Static SystemParameters.WindowCaptionHeight}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: hamburger, icon and title on the left, search box in the middle. -->
        <!-- Width = the part of the band the system caption buttons leave free. -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
              Width="{Binding Path=(shell:WindowChrome.TitleBarBounds).Width, RelativeSource={RelativeSource Self}}">
            <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE700;" FontFamily="{StaticResource IconFont}" Width="36" Height="28" Background="Transparent" BorderThickness="0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="8,0,8,0" VerticalAlignment="Center"
                               Foreground="{Binding Path=(shell:WindowChrome.CaptionForeground), RelativeSource={RelativeSource Self}}"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{Binding Path=(shell:WindowChrome.CaptionForeground), RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <TextBox Grid.Column="1" Width="360" Height="30" HorizontalAlignment="Center" VerticalContentAlignment="Center"
                         Padding="8,0" ToolTip="Search for a process"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Grid>

        <!-- Navigation on the acrylic. -->
        <ListBox x:Name="Nav" Grid.Row="2" Grid.Column="0" Background="Transparent" BorderThickness="0" Margin="8,4,8,8" SelectedIndex="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,4">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Opaque content card. -->
        <Border Grid.Row="2" Grid.Column="1" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="20,14,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Processes" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Padding="12,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Run new task"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="End task"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="14,0,14,8">
                    <Border Margin="6,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel><TextBlock Text="CPU" Opacity="0.7"/><TextBlock x:Name="CpuTotal" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Margin="6,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel><TextBlock Text="Memory" Opacity="0.7"/><TextBlock x:Name="MemTotal" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Margin="6,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel><TextBlock Text="Disk" Opacity="0.7"/><TextBlock x:Name="DiskTotal" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                </UniformGrid>

                <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          Margin="14,0,0,0" BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                          CanUserAddRows="False" SelectionMode="Single" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource NameCell}"/>
                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu, StringFormat={}{0:0.0}%}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HeatCell}">
                                    <Setter Property="Background" Value="{Binding Cpu, Converter={StaticResource Heat}, ConverterParameter=30}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Memory" Binding="{Binding Memory, StringFormat={}{0:0.0} MB}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HeatCell}">
                                    <Setter Property="Background" Value="{Binding Memory, Converter={StaticResource Heat}, ConverterParameter=1500}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Disk" Binding="{Binding Disk, StringFormat={}{0:0.0} MB/s}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HeatCell}">
                                    <Setter Property="Background" Value="{Binding Disk, Converter={StaticResource Heat}, ConverterParameter=40}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Network" Binding="{Binding Network, StringFormat={}{0:0.0} Mbps}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HeatCell}">
                                    <Setter Property="Background" Value="{Binding Network, Converter={StaticResource Heat}, ConverterParameter=40}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>



