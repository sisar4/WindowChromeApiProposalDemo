<UserControl x:Class="WindowChromeApiProposalDemo.FileExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowChromeApiProposalDemo"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Flat glyph button of the navigation bar. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="0" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fill of the area below the navigation bar (tree, splitter, status bar). Transparent by default. -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" IsHitTestVisible="False"
                Background="{Binding PageBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- Navigation bar -->
        <Border x:Name="NavigationBar" Grid.Row="0" Grid.ColumnSpan="3" Height="44"
                Background="{Binding NavigationBarBackground, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource NavButton}" Content="&#xE72B;" ToolTip="Back" Command="BrowseBack"/>
            <Button Grid.Column="1" Style="{StaticResource NavButton}" Content="&#xE72A;" ToolTip="Forward" Command="BrowseForward"/>
            <Button x:Name="RecentButton" Grid.Column="2" Style="{StaticResource NavButton}" Content="&#xE70D;" Width="20" FontSize="9" ToolTip="Recent locations" Click="Recent_Click"/>
            <Button Grid.Column="3" Style="{StaticResource NavButton}" Content="&#xE74A;" ToolTip="Up one level" Command="{x:Static local:FileExplorerControl.GoUpCommand}"/>
            <Border Grid.Column="4" Margin="6,6" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <TextBox x:Name="PathBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                         Padding="6,0" KeyDown="PathBox_KeyDown" GotKeyboardFocus="PathBox_GotKeyboardFocus"/>
            </Border>
            <Button Grid.Column="5" Style="{StaticResource NavButton}" Content="&#xE72C;" ToolTip="Refresh" Command="Refresh"/>
        </Grid>
        </Border>

        <TreeView x:Name="Tree" Grid.Column="0" Grid.Row="1" BorderThickness="0"
                  Background="{Binding TreeBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  SelectedItemChanged="Tree_SelectedItemChanged" />
        <GridSplitter Grid.Column="1" Grid.Row="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />
        <WebBrowser Grid.Column="2" Grid.Row="1" x:Name="Browser" />

        <!-- Status bar -->
        <Grid x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="3" Height="26" Margin="12,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.75"/>
        </Grid>
    </Grid>
</UserControl>
