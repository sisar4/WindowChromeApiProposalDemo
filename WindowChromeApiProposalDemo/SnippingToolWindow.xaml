<Window x:Class="WindowChromeApiProposalDemo.SnippingToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WindowChromeApiProposalDemo"
        Title="Snipping Tool" Width="760" Height="480" WindowStartupLocation="CenterScreen"
        ThemeMode="System" Background="Transparent">
    <!-- A negative GlassFrameThickness extends the frame over the whole window: with Acrylic the entire window is a sheet of acrylic. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome FrameMode="ExtendedClientArea" CaptionColor="Transparent" BackdropType="Acrylic" />
        <!--GlassFrameThickness="-1" (dafault when a BackdropBackdrop is set)-->
    </shell:WindowChrome.WindowChrome>

    <!-- Note: no implicit Style for ComboBox here. A Style with the same implicit key defined on the window replaces the one provided by the Fluent theme. -->

    <Grid Clip="{Binding Path=(shell:WindowChrome.CaptionButtonsClip), RelativeSource={RelativeSource Self}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Y, RelativeSource={RelativeSource Self}}"/>
            <RowDefinition Height="{Binding Path=(shell:WindowChrome.TitleBarBounds).Height, RelativeSource={RelativeSource Self}}"
                           MinHeight="{x:Static SystemParameters.WindowCaptionHeight}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xF7ED;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{Binding Path=(shell:WindowChrome.CaptionForeground), RelativeSource={RelativeSource Self}}"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{Binding Path=(shell:WindowChrome.CaptionForeground), RelativeSource={RelativeSource Self}}"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,6,16,10">
            <Button x:Name="NewButton" Padding="16,7" Click="New_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="New"/>
                </StackPanel>
            </Button>
            <ComboBox x:Name="ModeBox" SelectedIndex="0" MinWidth="170" Margin="8,0,0,0" VerticalAlignment="Center">
                <ComboBoxItem>Mode: rectangle</ComboBoxItem>
                <ComboBoxItem>Mode: window</ComboBoxItem>
                <ComboBoxItem>Mode: full screen</ComboBoxItem>
                <ComboBoxItem>Mode: free-form</ComboBoxItem>
            </ComboBox>
            <ComboBox SelectedIndex="0" MinWidth="170" Margin="8,0,0,0" VerticalAlignment="Center">
                <ComboBoxItem>No delay</ComboBoxItem>
                <ComboBoxItem>Delay of 3 seconds</ComboBoxItem>
                <ComboBoxItem>Delay of 5 seconds</ComboBoxItem>
                <ComboBoxItem>Delay of 10 seconds</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Everything below is translucent, so the acrylic shows through. -->
        <Border Grid.Row="3" Margin="16,0,16,16" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xF7ED;" FontFamily="{StaticResource IconFont}" FontSize="48" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Text="Press New to take a screenshot" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="or use Win + Shift + S" Opacity="0.65" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="Capture" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2B7CD3" Offset="0"/>
                            <GradientStop Color="#FF8B5CF6" Offset="0.55"/>
                            <GradientStop Color="#FFF59E0B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="CaptureLabel" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Region selection overlay -->
        <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Background="#66000000" Cursor="Cross" Focusable="True"
              MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp" KeyDown="Overlay_KeyDown">
            <TextBlock Text="Drag to select an area  (Esc to cancel)" Foreground="White" FontSize="14" Margin="0,60,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="Selection" Visibility="Collapsed" Stroke="White" StrokeThickness="2" StrokeDashArray="4 2" Fill="#33FFFFFF"/>
            </Canvas>
        </Grid>
    </Grid>
</Window>

