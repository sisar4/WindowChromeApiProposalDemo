<Window x:Class="WindowChromeApiProposalDemo.OrchardExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WindowChromeApiProposalDemo"
        Title="{Binding FolderName, ElementName=Explorer}" Width="1000" Height="640" WindowStartupLocation="CenterScreen"
        Background="#FFECECEC" FontFamily="Segoe UI" FontSize="12">
    <!-- Custom frame mode: no system caption at all, the window draws its own and only declares which elements act as
         caption buttons (CaptionButtonRole). The system then handles hit-testing, the snap layout flyout and the click. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome FrameMode="Custom" CaptionHeight="26" GlassFrameThickness="0"
                            ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Red / orange / green buttons. They are plain images: an element that cannot be invoked gets the window
             command of its role (close, minimize, maximize or restore) from the system, no handler needed.
             The image follows the hover and pressed states of the chrome (the pointer is owned by the system over them,
             so IsMouseOver and IsPressed never change). -->
        <Style x:Key="Light" TargetType="Image">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedLight" TargetType="Image" BasedOn="{StaticResource Light}">
            <Setter Property="Source" Value="/img/red.png"/>
            <Style.Triggers>
                <Trigger Property="shell:WindowChrome.IsCaptionButtonHovered" Value="True">
                    <Setter Property="Source" Value="/img/red3.png"/>
                </Trigger>
                <Trigger Property="shell:WindowChrome.IsCaptionButtonPressed" Value="True">
                    <Setter Property="Source" Value="/img/red2.png"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrangeLight" TargetType="Image" BasedOn="{StaticResource Light}">
            <Setter Property="Source" Value="/img/orange.png"/>
            <Style.Triggers>
                <Trigger Property="shell:WindowChrome.IsCaptionButtonHovered" Value="True">
                    <Setter Property="Source" Value="/img/orange3.png"/>
                </Trigger>
                <Trigger Property="shell:WindowChrome.IsCaptionButtonPressed" Value="True">
                    <Setter Property="Source" Value="/img/orange2.png"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GreenLight" TargetType="Image" BasedOn="{StaticResource Light}">
            <Setter Property="Source" Value="/img/green.png"/>
            <Style.Triggers>
                <Trigger Property="shell:WindowChrome.IsCaptionButtonHovered" Value="True">
                    <Setter Property="Source" Value="/img/green3.png"/>
                </Trigger>
                <Trigger Property="shell:WindowChrome.IsCaptionButtonPressed" Value="True">
                    <Setter Property="Source" Value="/img/green2.png"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Glossy gel toolbar button. -->
        <Style x:Key="GelButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF303030"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="CommandTarget" Value="{Binding ElementName=Explorer}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" BorderBrush="#FF7B7B7B" BorderThickness="1" CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFDFDFD" Offset="0"/>
                                    <GradientStop Color="#FFE3E3E3" Offset="0.5"/>
                                    <GradientStop Color="#FFCFCFCF" Offset="0.5"/>
                                    <GradientStop Color="#FFE9E9E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB5B5B5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A maximized window is larger than the monitor by its (invisible) frame: keep the content inside. -->
    <Border BorderBrush="#FF4D4D4D" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <ImageBrush ImageSource="/img/bar.bmp" Stretch="Fill"/>
                </Grid.Background>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="13" Foreground="#FF222222">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" ShadowDepth="1" Direction="270" BlurRadius="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Image Style="{StaticResource RedLight}" shell:WindowChrome.CaptionButtonRole="Close" ToolTip="Close"/>
                    <Image Style="{StaticResource OrangeLight}" shell:WindowChrome.CaptionButtonRole="Minimize" ToolTip="Minimize"/>
                    <Image Style="{StaticResource GreenLight}" shell:WindowChrome.CaptionButtonRole="Maximize" ToolTip="Maximize"/>
                </StackPanel>
            </Grid>

            <!-- Nav bar -->
            <Border Grid.Row="1" BorderBrush="#FF5A5A5A" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFCBCBCB" Offset="0"/>
                        <GradientStop Color="#FFA8A8A8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource GelButton}" Content="&#xE72B;" ToolTip="Back" Command="BrowseBack"/>
                        <Button Style="{StaticResource GelButton}" Content="&#xE72A;" ToolTip="Forward" Command="BrowseForward" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GelButton}" Content="&#xE74A;" ToolTip="Up one level"
                            Command="{x:Static local:FileExplorerControl.GoUpCommand}" Margin="14,0,0,0"/>
                    <Border Grid.Column="2" Margin="14,0" Height="24" VerticalAlignment="Center" CornerRadius="12" BorderThickness="1"
                            BorderBrush="#FF6E6E6E" Background="White">
                        <TextBlock Text="{Binding FolderPath, ElementName=Explorer}" Padding="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource GelButton}" Content="&#xE72C;" ToolTip="Refresh" Command="Refresh"/>
                </Grid>
            </Border>

            <local:FileExplorerControl x:Name="Explorer" Grid.Row="2" IsNavigationBarVisible="False" TreeBackground="#FFD9E0E8"/>
        </Grid>
    </Border>
</Window>
